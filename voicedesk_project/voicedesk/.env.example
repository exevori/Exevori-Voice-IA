# Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio (compte maître Exevori)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_MASTER_AGENT_ID=agent_xxxxxxxxxxxxxxxx
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_signing_secret
ELEVENLABS_CUSTOM_LLM_SECRET=development_only_shared_secret
# Obligatoire en production : un secret distinct par agent. Ce mapping
# remplace le secret global et lie chaque requête à l'agent annoncé.
ELEVENLABS_CUSTOM_LLM_AGENT_SECRETS_JSON={"agent_id":"unique_random_secret_for_this_agent"}
ELEVENLABS_OUTBOUND_TIMEOUT_MS=15000

# Groq (LLM voix principal)
GROQ_API_KEY=gsk_xxxxxxxxxxxx

# Fireworks (LLM fallback)
FIREWORKS_API_KEY=fw_xxxxxxxxxxxx
# Embeddings RAG (endpoint Fireworks fixé dans le code, sortie vector(1536))
FIREWORKS_EMBEDDING_MODEL=fireworks/qwen3-embedding-8b
FIREWORKS_EMBEDDING_TIMEOUT_MS=10000
FIREWORKS_EMBEDDING_MAX_RETRIES=2
FIREWORKS_EMBEDDING_RETRY_BASE_MS=250

# Resend (emails)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Chiffrement serveur (32 octets aléatoires encodés en base64)
ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_random_key

# Calendly OAuth par entreprise
CALENDLY_CLIENT_ID=your_calendly_oauth_client_id
CALENDLY_CLIENT_SECRET=your_calendly_oauth_client_secret
CALENDLY_REDIRECT_URI=https://api.votre-domaine.com/api/v1/calendar/oauth/callback
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_signing_key
# Scope Enterprise seulement; laisser false si le compte ne le supporte pas.
CALENDLY_DATA_COMPLIANCE_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
# Activer uniquement après avoir confirmé les registrations Stripe Tax actives.
STRIPE_TAX_ENABLED=false
# Configuration Customer Portal contenant les produits/prix autorisés.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxxxxxxxxxxx
# Prix stables par plan, devise et cycle. Laisser {} tant que non configuré.
STRIPE_PRICE_IDS_JSON={}

# App
APP_PUBLIC_URL=https://votre-domaine.com
FRONTEND_URL=https://votre-domaine.com
EMAIL_FROM=VoiceDesk <bonjour@voicedesk.ca>
PORT=8001
# Nombre exact de reverse proxies devant Express (0 en accès direct, souvent 1).
TRUST_PROXY_HOPS=1
# Limite grossière avant vérification des signatures/secrets M2M.
M2M_INGRESS_RATE_LIMIT_PER_MINUTE=3000
DISABLE_PRIVACY_RETENTION_JOB=false
DISABLE_PRIVACY_CONSENT_SYNC=false
DISABLE_OUTBOUND_WORKER=false
OUTBOUND_RECOVERY_INTERVAL_MS=60000
OUTBOUND_HEARTBEAT_TTL_MS=120000
OUTBOUND_RETRY_BASE_MS=30000
OUTBOUND_RETRY_MAX_MS=900000
# Quarantaine après une erreur de clé, compte ou agent ElevenLabs.
OUTBOUND_PROVIDER_CONFIGURATION_BACKOFF_MS=900000
# Doit correspondre à la durée maximale configurée sur les agents ElevenLabs.
OUTBOUND_RESERVED_MINUTES=10
# Optionnel : si absent, un identifiant unique est généré à chaque processus.
OUTBOUND_WORKER_ID=
# Worker durable pour l'analyse et les effets CRM post-appel.
DISABLE_POST_CALL_WORKER=false
POST_CALL_ANALYSIS_TIMEOUT_MS=45000
POST_CALL_JOB_LEASE_SECONDS=120
# Optionnel : si absent, un identifiant unique est généré à chaque processus.
POST_CALL_WORKER_ID=
DISABLE_CALENDAR_WORKER=false
CALENDAR_WORKER_INTERVAL_MS=5000
CALENDAR_WORKER_BATCH_SIZE=20
CALENDAR_RETENTION_INTERVAL_MS=21600000
# Optionnel : si absent, un identifiant unique est généré à chaque processus.
CALENDAR_WORKER_ID=
# Base de connaissances : ingestion durable et scraping SSRF-safe.
DISABLE_KB_WORKER=false
KB_WORKER_INTERVAL_MS=5000
KB_WORKER_BATCH_SIZE=2
KB_WORKER_LEASE_SECONDS=120
# Optionnel : si absent, un identifiant unique est généré à chaque processus.
KB_WORKER_ID=
# Obligatoire pour importer une URL. Domaines exacts ou *.sous-domaines,
# séparés par des virgules. Une liste vide bloque tout scraping (fail-closed).
KB_SCRAPE_ALLOWED_DOMAINS=example.com,*.example.com
KB_SCRAPE_TIMEOUT_MS=8000
KB_SCRAPE_MAX_BYTES=2097152
KB_SCRAPE_MAX_REDIRECTS=3
# Support tickets : livraison Resend durable + alertes SLA.
DISABLE_TICKET_WORKER=false
TICKET_WORKER_INTERVAL_MS=60000
TICKET_WORKER_BATCH_SIZE=20
TICKET_WORKER_LEASE_SECONDS=120
# Optionnel : si absent, un identifiant unique est généré à chaque processus.
TICKET_WORKER_ID=
PRIVACY_CONSENT_SYNC_MAX_ATTEMPTS=8
PRIVACY_CONSENT_SYNC_RETRY_BASE_MS=30000
PRIVACY_CONSENT_SYNC_RETRY_MAX_MS=1800000
PRIVACY_CONSENT_SYNC_RECOVERY_MS=21600000
PRIVACY_PROVIDER_TIMEOUT_MS=10000
